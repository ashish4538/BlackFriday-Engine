# Choose local database passwords before starting Compose.
DB_PASSWORD=replace-with-local-app-password
DB_ROOT_PASSWORD=replace-with-local-root-password
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/flashsale
SPRING_DATASOURCE_USERNAME=flashsale
SPRING_DATASOURCE_PASSWORD=replace-with-local-app-password
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Use false only for local HTTP.
SESSION_COOKIE_SECURE=false
